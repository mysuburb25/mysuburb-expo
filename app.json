{
  "expo": {
    "name": "My Suburb",
    "slug": "mysuburb",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mysuburb.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mysuburb.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2D6A4F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "My Suburb needs access to your photos so you can attach images to your posts.",
          "cameraPermission": "My Suburb needs access to your camera so you can take photos for your posts."
        }
      ]
    ],
    "scheme": "mysuburb",
    "extra": {
      "eas": {
        "projectId": "bdc0ac98-8f69-4928-94a0-ac468d4f97fb"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bdc0ac98-8f69-4928-94a0-ac468d4f97fb"
    }
  }
}