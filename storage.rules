rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos — the filename must be the uploader's own UID, so a
    // user can only ever create/overwrite their own photo, never someone
    // else's. 5MB cap, must actually be an image.
    match /profilePhotos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Post images — the storage path is keyed by postId (a generated
    // Firestore document ID), not the uploader's uid, so ownership can't
    // be checked from the path alone. Instead we look up the matching
    // Firestore post document and confirm its authorId is the uploader.
    // Safe because the post doc is always created (with authorId set)
    // before its images are uploaded — see create-post.js / events.js.
    // 10MB cap per image, must actually be an image.
    match /posts/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/posts/$(postId)).data.authorId == request.auth.uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else by default — no other paths are used by the
    // app, so there's no reason to leave them open.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}