rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function unchangedField(field) {
      return !(field in request.resource.data) ||
             (field in resource.data && request.resource.data[field] == resource.data[field]);
    }

    function isValidCountToggle(countField, arrayField) {
      let beforeArr = resource.data.get(arrayField, []);
      let afterArr = request.resource.data.get(arrayField, []);
      let beforeCount = resource.data.get(countField, 0);
      let afterCount = request.resource.data.get(countField, 0);
      return
        (afterCount == beforeCount + 1
          && !(request.auth.uid in beforeArr)
          && request.auth.uid in afterArr
          && afterArr.size() == beforeArr.size() + 1)
        ||
        (afterCount == beforeCount - 1
          && request.auth.uid in beforeArr
          && !(request.auth.uid in afterArr)
          && afterArr.size() == beforeArr.size() - 1);
    }

    function isValidArrayToggle(arrayField) {
      let beforeArr = resource.data.get(arrayField, []);
      let afterArr = request.resource.data.get(arrayField, []);
      return
        (!(request.auth.uid in beforeArr)
          && request.auth.uid in afterArr
          && afterArr.size() == beforeArr.size() + 1)
        ||
        (request.auth.uid in beforeArr
          && !(request.auth.uid in afterArr)
          && afterArr.size() == beforeArr.size() - 1);
    }

    match /users/{uid} {
      allow read: if isSignedIn();

      allow create: if isSelf(uid)
                    && request.resource.data.isAdmin == false
                    && request.resource.data.isSuspended == false;

      allow update: if
        (isSelf(uid)
          && unchangedField('isAdmin')
          && unchangedField('isSuspended'))
        ||
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isSuspended']));

      allow delete: if isSelf(uid);

      match /private/{document} {
        allow read, write: if isSelf(uid);
      }
    }

    match /posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.isRemoved == false
                    && request.resource.data.likeCount == 0
                    && request.resource.data.commentCount == 0;

      allow update: if
        // Owner editing their own post — covers both the original
        // remove/restore + content/images path, and the newer Edit Post
        // feature (description, price, and location fields). Kept in one
        // clause since they're all "the owner editing their own content"
        // and share the same authorization check.
        (request.auth.uid == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['isRemoved', 'content', 'images', 'description', 'price', 'eventLocation', 'lostFoundLocation']))
        ||
        (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likeCount', 'likedBy'])
          && isValidCountToggle('likeCount', 'likedBy'))
        ||
        (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['commentCount'])
          && request.resource.data.commentCount == resource.data.commentCount + 1)
        ||
        (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['attendeeCount', 'attendees'])
          && isValidCountToggle('attendeeCount', 'attendees'))
        ||
        (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['savedBy'])
          && isValidArrayToggle('savedBy'))
        ||
        // closedAt travels alongside isSold/isResolved so the client can
        // record exactly when a post was closed (used for the 24-hour
        // grace period logic, and just generally useful data to have).
        (request.auth.uid == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['isSold', 'closedAt']))
        ||
        (request.auth.uid == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['isResolved', 'closedAt']))
        ||
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRemoved']));

      allow delete: if false;
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.likeCount == 0;

      allow update: if
        (request.auth.uid == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'isDeleted'])
          && request.resource.data.content == '[This comment was deleted]'
          && request.resource.data.isDeleted == true)
        ||
        (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likeCount', 'likedBy'])
          && isValidCountToggle('likeCount', 'likedBy'));

      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;

      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && resource.data.participants[0] in request.resource.data.participants
                    && resource.data.participants[1] in request.resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        function isParticipant() {
          return isSignedIn() && request.auth.uid in conversationId.split('_');
        }

        function otherParticipant() {
          let parts = conversationId.split('_');
          return parts[0] == request.auth.uid ? parts[1] : parts[0];
        }

        function recipientHasBlockedSender() {
          let recipientDoc = get(/databases/$(database)/documents/users/$(otherParticipant()));
          return request.auth.uid in recipientDoc.data.get('blockedUserIds', []);
        }

        allow read: if isParticipant();

        allow create: if isParticipant()
                      && request.resource.data.senderId == request.auth.uid
                      && !recipientHasBlockedSender();

        allow update: if isParticipant()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

        allow delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;

      function isValidPostNotification() {
        return request.resource.data.postId is string
          && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.authorId == request.resource.data.userId;
      }

      function isValidCommentNotification() {
        return request.resource.data.commentId is string
          && get(/databases/$(database)/documents/comments/$(request.resource.data.commentId)).data.authorId == request.resource.data.userId;
      }

      function isValidMessageNotification() {
        return request.resource.data.conversationId is string
          && request.resource.data.userId in request.resource.data.conversationId.split('_');
      }

      function isValidNewPostNotification() {
        let post = get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data;
        let recipient = get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data;
        let suburbKey = post.state + '|' + post.suburb;
        return request.resource.data.postId is string
          && post.authorId == request.resource.data.fromUserId
          && suburbKey in recipient.get('activeSuburbKeys', []);
      }

      function isValidWarningNotification() {
        return isAdmin();
      }

      allow create: if isSignedIn()
                    && request.resource.data.fromUserId == request.auth.uid
                    && request.resource.data.isRead == false
                    && request.resource.data.userId != request.auth.uid
                    && (
                         (request.resource.data.type in ['like', 'comment'] && isValidPostNotification())
                         || (request.resource.data.type in ['comment_like', 'comment_reply'] && isValidCommentNotification())
                         || (request.resource.data.type == 'message' && isValidMessageNotification())
                         || (request.resource.data.type == 'new_post' && isValidNewPostNotification())
                         || (request.resource.data.type == 'admin_warning' && isValidWarningNotification())
                       );

      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);

      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'resolvedAt', 'resolvedBy']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}