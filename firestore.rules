rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function unchangedField(field) {
      return !(field in request.resource.data) ||
             (field in resource.data && request.resource.data[field] == resource.data[field]);
    }

    match /users/{uid} {
      allow read: if isSignedIn();

      allow create: if isSelf(uid)
                    && request.resource.data.isAdmin == false
                    && request.resource.data.isSuspended == false;

      allow update: if isSelf(uid)
                    && unchangedField('isAdmin')
                    && unchangedField('isSuspended');

      allow delete: if isSelf(uid);

      match /private/{document} {
        allow read, write: if isSelf(uid);
      }
    }

    match /posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.isRemoved == false
                    && request.resource.data.likeCount == 0
                    && request.resource.data.commentCount == 0;

      allow update: if
        (request.auth.uid == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['isRemoved', 'content', 'images']))
        ||
        (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likeCount', 'likedBy']))
        ||
        (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['commentCount']))
        ||
        (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['attendeeCount', 'attendees']))
        ||
        (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['savedBy']))
        ||
        (request.auth.uid == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['isSold']));

      allow delete: if false;
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.likeCount == 0;

      allow update: if
        (request.auth.uid == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'isDeleted'])
          && request.resource.data.content == '[This comment was deleted]'
          && request.resource.data.isDeleted == true)
        ||
        (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likeCount', 'likedBy']));

      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;

      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && resource.data.participants[0] in request.resource.data.participants
                    && resource.data.participants[1] in request.resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        function isParticipant() {
          return isSignedIn() && request.auth.uid in conversationId.split('_');
        }

        // The other person in this 1:1 conversation — used to look up
        // whether they've blocked the sender before allowing a message
        // through. Safe to assume exactly two participants since
        // conversations are always created with participants.size() == 2.
        function otherParticipant() {
          let parts = conversationId.split('_');
          return parts[0] == request.auth.uid ? parts[1] : parts[0];
        }

        // Enforces blocking server-side: if the recipient has the sender
        // in their blockedUserIds, the message write is rejected outright,
        // rather than relying only on the client hiding the option. Uses
        // .get(field, default) so this doesn't break for older user docs
        // that predate this field existing. Costs one extra document read
        // per message send — an acceptable tradeoff for actually enforcing
        // the block rather than just hiding it in the UI.
        function recipientHasBlockedSender() {
          let recipientDoc = get(/databases/$(database)/documents/users/$(otherParticipant()));
          return request.auth.uid in recipientDoc.data.get('blockedUserIds', []);
        }

        allow read: if isParticipant();

        allow create: if isParticipant()
                      && request.resource.data.senderId == request.auth.uid
                      && !recipientHasBlockedSender();

        allow update: if isParticipant()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

        allow delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;

      allow create: if isSignedIn()
                    && request.resource.data.fromUserId == request.auth.uid
                    && request.resource.data.isRead == false;

      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);

      allow delete: if false;
    }

    match /reports/{reportId} {
      function isAdmin() {
        return isSignedIn() &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      }

      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'resolvedAt', 'resolvedBy']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}